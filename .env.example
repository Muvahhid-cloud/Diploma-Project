# Copy to .env (repo root) and adjust. Never commit .env.
# Used by docker compose and by the API when run locally (it reads ../../.env and ./.env
# relative to apps/api; real environment variables take precedence).

# --- Environment ---------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=buildai
POSTGRES_PASSWORD=buildai-dev-password
POSTGRES_DB=buildai
# Async driver required. In docker compose the host is "db"; locally use localhost
# or the URL printed by `pnpm db:local` (embedded Postgres, no Docker needed).
DATABASE_URL=postgresql+asyncpg://buildai:buildai-dev-password@localhost:5432/buildai

# --- Auth ----------------------------------------------------------------------
# REQUIRED, min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set false only for plain-http local development
COOKIE_SECURE=false

# Only needed if the browser calls the API cross-origin (the web app proxies /api by default)
CORS_ORIGINS=

# --- Product defaults (decided: Kazakhstan / KZT) ------------------------------
DEFAULT_REGION_CODE=KZ-ALA
DEFAULT_CURRENCY=KZT
DEFAULT_RULES_PROFILE=generic-residential@1

# --- AI (Phase 3; tests always use mock) ---------------------------------------
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=

# --- Local demo account (DEVELOPMENT ONLY; used by manual testing / future `pnpm seed`) --
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=demo-password-2026

# --- Web -----------------------------------------------------------------------
# Where the Next.js server proxies /api/* (build-time for `next build`)
API_PROXY_URL=http://localhost:8000
