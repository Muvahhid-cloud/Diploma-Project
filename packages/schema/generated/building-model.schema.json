        "semantic_key": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "door",
          "default": "door",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/DoorDimensions"
        },
        "properties": {
          "$ref": "#/$defs/DoorProperties"
        }
      },
      "required": [
