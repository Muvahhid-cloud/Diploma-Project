{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED from Pydantic (app/modules/ai/schemas/responses.py). Do not edit.",
  "title": "AIGenerationContracts",
  "$defs": {
    "AIGenerateRequest": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt": {
          "maxLength": 4000,
          "minLength": 3,
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/GenerationOptions"
        }
      },
      "required": [
        "prompt"
      ],
      "title": "AIGenerateRequest",
      "type": "object"
    },
    "AIGenerationList": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AIGenerationSummaryOut"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "AIGenerationList",
      "type": "object"
    },
    "AIGenerationOut": {
      "description": "Full generation record: what was asked, what the AI understood, what was built.",
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "needs_clarification",
            "failed"
          ],
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "interpreting",
                "validating",
                "repairing",
                "layout",
                "checking",
                "saving",
                "done"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "understanding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "clarification_questions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationErrorOut"
            },
            {
              "type": "null"
            }
          ]
        },
        "repair_count": {
          "type": "integer"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "$ref": "#/$defs/GenerationOptions"
        },
        "prompt_version": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "rules_profile": {
          "type": "string"
        },
        "engine_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "specification": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildingSpecification"
            },
            {
              "type": "null"
            }
          ]
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/RequirementCheck"
          },
          "type": "array"
        },
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "project_id",
        "status",
        "stage",
        "prompt",
        "provider",
        "model",
        "understanding",
        "version_id",
        "version_number",
        "clarification_questions",
        "error",
        "repair_count",
        "duration_ms",
        "created_at",
        "finished_at",
        "options",
        "prompt_version",
        "seed",
        "rules_profile",
        "engine_version",
        "specification",
        "assumptions",
        "warnings",
        "summary",
        "checks",
        "input_tokens",
        "output_tokens",
        "started_at"
      ],
      "title": "AIGenerationOut",
      "type": "object"
    },
    "AIGenerationSummaryOut": {
      "description": "One entry of a project's generation history.",
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "needs_clarification",
            "failed"
          ],
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "queued",
                "interpreting",
                "validating",
                "repairing",
                "layout",
                "checking",
                "saving",
                "done"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "understanding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "clarification_questions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenerationErrorOut"
            },
            {
              "type": "null"
            }
          ]
        },
        "repair_count": {
          "type": "integer"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "project_id",
        "status",
        "stage",
        "prompt",
        "provider",
        "model",
        "understanding",
        "version_id",
        "version_number",
        "clarification_questions",
        "error",
        "repair_count",
        "duration_ms",
        "created_at",
        "finished_at"
      ],
      "title": "AIGenerationSummaryOut",
      "type": "object"
    },
    "ArchitecturalStyle": {
      "enum": [
        "modern",
        "minimalist",
        "contemporary",
        "classic",
        "traditional",
        "scandinavian",
        "industrial",
        "mediterranean",
        "luxury"
      ],
      "title": "ArchitecturalStyle",
      "type": "string"
    },
    "Assumption": {
      "additionalProperties": false,
      "description": "Something that was inferred rather than stated (shown to the user).",
      "properties": {
        "path": {
          "maxLength": 200,
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "maxLength": 500,
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Balcony": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        },
        "attached_to": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "side": {
          "default": "garden",
          "enum": [
            "garden",
            "street"
          ],
          "type": "string"
        },
        "width_m": {
          "anyOf": [
            {
              "maximum": 12,
              "minimum": 1.2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "depth_m": {
          "default": 1.5,
          "maximum": 3.0,
          "minimum": 0.8,
          "type": "number"
        }
      },
      "required": [
        "level"
      ],
      "title": "Balcony",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "A constraint recorded with the spec. Nothing is costed from it in Phase 2.",
      "properties": {
        "amount": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Budget",
      "type": "object"
    },
    "BuildingSpecification": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "type": "string"
        },
        "building_type": {
          "const": "single_family_house",
          "default": "single_family_house",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "type": "string"
        },
        "targets": {
          "$ref": "#/$defs/Targets"
        },
        "site": {
          "anyOf": [
            {
              "$ref": "#/$defs/Site"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "rooms": {
          "items": {
            "$ref": "#/$defs/RoomRequirement"
          },
          "maxItems": 40,
          "minItems": 1,
          "type": "array"
        },
        "features": {
          "$ref": "#/$defs/Features"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "maxItems": 50,
          "type": "array"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "name",
        "targets",
        "rooms"
      ],
      "title": "BuildingSpecification",
      "type": "object"
    },
    "FacadeMaterial": {
      "description": "High-level facade choice; the layout engine maps it to material-library ids.",
      "enum": [
        "render",
        "brick",
        "concrete",
        "timber"
      ],
      "title": "FacadeMaterial",
      "type": "string"
    },
    "Features": {
      "additionalProperties": false,
      "properties": {
        "garage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Garage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "balconies": {
          "items": {
            "$ref": "#/$defs/Balcony"
          },
          "maxItems": 4,
          "type": "array"
        },
        "terrace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Terrace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Features",
      "type": "object"
    },
    "FinishLevel": {
      "enum": [
        "economy",
        "standard",
        "premium"
      ],
      "title": "FinishLevel",
      "type": "string"
    },
    "Garage": {
      "additionalProperties": false,
      "properties": {
        "cars": {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "cars"
      ],
      "title": "Garage",
      "type": "object"
    },
    "GenerationErrorOut": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "GenerationErrorOut",
      "type": "object"
    },
    "GenerationOptions": {
      "additionalProperties": false,
      "description": "Optional structured fields next to the prompt. They are explicit user requirements:\nthe interpreter must honour them, and the generation service verifies that it did.",
      "properties": {
        "gross_floor_area_m2": {
          "anyOf": [
            {
              "maximum": 2000,
              "minimum": 20,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "storeys": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "architectural_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArchitecturalStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region_code": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 2,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seed": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "GenerationOptions",
      "type": "object"
    },
    "InteriorStyle": {
      "enum": [
        "minimalist",
        "modern",
        "classic",
        "scandinavian",
        "industrial",
        "luxury",
        "cozy"
      ],
      "title": "InteriorStyle",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "element_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "severity",
        "code",
        "path",
        "message",
        "suggestion",
        "rule_ref",
        "element_id"
      ],
      "title": "Issue",
      "type": "object"
    },
    "ModelSummary": {
      "additionalProperties": false,
      "properties": {
        "storeys": {
          "type": "integer"
        },
        "gross_floor_area_m2": {
          "type": "number"
        },
        "net_floor_area_m2": {
          "type": "number"
        },
        "rooms": {
          "type": "integer"
        },
        "bedrooms": {
          "type": "integer"
        },
        "bathrooms": {
          "type": "integer"
        },
        "wcs": {
          "type": "integer"
        },
        "garage": {
          "type": "boolean"
        },
        "balconies": {
          "type": "integer"
        },
        "terraces": {
          "type": "integer"
        },
        "walls": {
          "type": "integer"
        },
        "doors": {
          "type": "integer"
        },
        "windows": {
          "type": "integer"
        },
        "elements": {
          "type": "integer"
        }
      },
      "required": [
        "storeys",
        "gross_floor_area_m2",
        "net_floor_area_m2",
        "rooms",
        "bedrooms",
        "bathrooms",
        "wcs",
        "garage",
        "balconies",
        "terraces",
        "walls",
        "doors",
        "windows",
        "elements"
      ],
      "title": "ModelSummary",
      "type": "object"
    },
    "RequirementCheck": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "requested": {
          "type": "string"
        },
        "delivered": {
          "type": "string"
        },
        "met": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label",
        "requested",
        "delivered",
        "met"
      ],
      "title": "RequirementCheck",
      "type": "object"
    },
    "RoofSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/RoofType"
        },
        "pitch_deg": {
          "anyOf": [
            {
              "maximum": 45,
              "minimum": 5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "RoofSpec",
      "type": "object"
    },
    "RoofType": {
      "enum": [
        "flat",
        "gable",
        "hip"
      ],
      "title": "RoofType",
      "type": "string"
    },
    "RoomFeature": {
      "description": "Rooms attached to a bedroom and reached through it.",
      "enum": [
        "en_suite",
        "walk_in_closet"
      ],
      "title": "RoomFeature",
      "type": "string"
    },
    "RoomRequirement": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SpecRoomType"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "count": {
          "default": 1,
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "target_area_m2": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "min_area_m2": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "level": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "adjacent_to": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 8,
          "type": "array"
        },
        "open_to": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/RoomFeature"
          },
          "maxItems": 2,
          "type": "array"
        }
      },
      "required": [
        "key",
        "type"
      ],
      "title": "RoomRequirement",
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "description": "Plot and setbacks. The street is on the model's south side (-y).",
      "properties": {
        "plot_width_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "type": "number"
